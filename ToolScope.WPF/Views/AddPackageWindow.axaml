<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ToolScope.WPF.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ToolScope.WPF.Views.AddPackageWindow"
             x:DataType="vm:AddPackageWindowViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:AddPackageWindowViewModel/>
    </Design.DataContext>
    <Grid RowDefinitions="20,10,*,*" ColumnDefinitions="*,100,*" Margin="30,10">
        <StackPanel Grid.Row="2" Classes="tabItem">
            <StackPanel>
                <TextBlock Classes="h3" Text="Select country"></TextBlock>
                <AutoCompleteBox MinimumPrefixLength="0" ItemsSource="{Binding Countries}" 
                                 Text="{Binding SelectedCountry}"></AutoCompleteBox>
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="h3" Text="Select package to install"></TextBlock>
                <ListBox ItemsSource="{Binding PackagesListBox}" SelectedIndex="{Binding SelectedPackageIndex}">
                </ListBox>
                <TextBlock Classes="dimmed">Update packages are hidden and have to be installed in the Manager.</TextBlock>
            </StackPanel>
            <StackPanel>
                <Button Classes="highlighted" Content="Install Package" 
                        Command="{Binding InstallPackage}" 
                        IsEnabled="{Binding IsInstallButtonEnabled}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
