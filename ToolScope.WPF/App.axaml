<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ToolScope.WPF.App"
             xmlns:local="using:ToolScope.WPF"
             
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
             
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Main.axaml" />
    </Application.Styles>
             
    <Application.Resources>
        <FontFamily x:Key="FontAwesome">avares://ToolScope.WPF/Assets/Fonts/Font Awesome 6 Free-Solid-900.otf#Font Awesome 6 Free</FontFamily>
    </Application.Resources>
</Application>  